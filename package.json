{
  "name": "zilite",
  "version": "1.0.1",
  "description": "An easy-to-use syntax highlighter for the web.",
  "author": {
    "name": "Rohan Vashisht",
    "email": "rohanprogrammer1@gmail.com"
  },
  "keywords": [
    "syntax",
    "highlight",
    "typescript",
    "highlighter"
  ],
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc  && mkdir -p dist/styles && cp -r src/styles/* dist/styles/ && esbuild ./dist/**/*.{js,mjs,css}  --outdir=./dist --minify --format=esm --allow-overwrite",
    "format": "prettier . --write",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.4",
    "esbuild": "^0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zigistry/zilite.git"
  },
  "bugs": {
    "url": "https://github.com/zigistry/zilite/issues"
  },
  "homepage": "https://github.com/zigistry/zilite#readme",
  "type": "module"
}